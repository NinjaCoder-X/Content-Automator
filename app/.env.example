# Required: long random string used to sign session JWTs
AUTH_SECRET=replace-me-with-a-long-random-string

# Optional: use a different SQLite path (defaults to ./data/app.db)
DATABASE_PATH=./data/app.db

# Optional: enable real Stripe billing. If unset, the app uses a built-in
# demo checkout that flips the user's plan immediately.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_WEBHOOK_SECRET=

# Optional: OpenAI key. If unset, the app uses its built-in deterministic
# content engine (works fully without any external API).
OPENAI_API_KEY=
